using System;
using System.Collections.Generic;
using System.IO;
using System.Text.RegularExpressions;
using Autodesk.AutoCAD.ApplicationServices;
using Autodesk.AutoCAD.EditorInput;
using Autodesk.AutoCAD.Runtime;
using WinForms = System.Windows.Forms;
using AcApp = Autodesk.AutoCAD.ApplicationServices.Application;

[assembly: ExtensionApplication(typeof(AcadBridge.Plugin))]

namespace AcadBridge
{
    public class Plugin : IExtensionApplication
    {
        // Cartella e file scritti dalla pagina HTML
        // Ordine di scelta:
        // 1) variabile d'ambiente ACADBRIDGE_DIR, se impostata (può contenere altre variabili, es. %LOCALAPPDATA%\Altro)
        // 2) altrimenti %LOCALAPPDATA%\EasyCut
        static readonly string Folder = RisolviCartella();

        static string RisolviCartella()
        {
            string custom = Environment.GetEnvironmentVariable("ACADBRIDGE_DIR");
            if (!string.IsNullOrWhiteSpace(custom))
                return Environment.ExpandEnvironmentVariables(custom.Trim());

            return Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                "EasyCut");
        }
        const string CmdFile = "cmd.txt";

        // Solo queste funzioni LISP possono essere chiamate
        static readonly HashSet<string> Whitelist =
            new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "myfunc" };

        // Argomento: lettere, numeri, spazi, punto, trattino, underscore
        static readonly Regex ArgOk = new Regex(@"^[\w\s.\-]{0,200}$");

        // Statici: il comando BRIDGESTATO viene eseguito su un'istanza diversa della classe
        static WinForms.Timer _timer;
        static int _ricevuti;
        static string _ultimo = "(nessuno)";

        public void Initialize()
        {
            Avvia();
        }

        public void Terminate()
        {
            Ferma();
        }

        static void Avvia()
        {
            if (_timer != null && _timer.Enabled) return;
            Directory.CreateDirectory(Folder);
            // Il Timer di WinForms gira sul thread UI di AutoCAD: sicuro per l'API
            _timer = new WinForms.Timer { Interval = 500 };
            _timer.Tick += OnTick;
            _timer.Start();
        }

        static void Ferma()
        {
            if (_timer == null) return;
            _timer.Stop();
            _timer.Tick -= OnTick;
            _timer.Dispose();
            _timer = null;
        }

        [CommandMethod("BRIDGESTOP")]
        public void BridgeStop()
        {
            Ferma();
            AcApp.DocumentManager.MdiActiveDocument?.Editor.WriteMessage("\n[Bridge] Fermato.\n");
        }

        [CommandMethod("BRIDGESTART")]
        public void BridgeStart()
        {
            Avvia();
            AcApp.DocumentManager.MdiActiveDocument?.Editor.WriteMessage("\n[Bridge] Avviato.\n");
        }

        [CommandMethod("BRIDGEHELP")]
        public void BridgeHelp()
        {
            Document doc = AcApp.DocumentManager.MdiActiveDocument;
            if (doc == null) return;
            Editor ed = doc.Editor;

            ed.WriteMessage("\n=== AcadBridge - Aiuto ===");

            ed.WriteMessage("\n\nCOMANDI DI AUTOCAD:");
            ed.WriteMessage("\n  BRIDGEHELP    Mostra questo elenco");
            ed.WriteMessage("\n  BRIDGESTATO   Stato del ponte, cartella, contatori, ultimo comando");
            ed.WriteMessage("\n  BRIDGESTART   Avvia il controllo della cartella");
            ed.WriteMessage("\n  BRIDGESTOP    Ferma il controllo (i file restano in attesa)");

            ed.WriteMessage("\n\nFUNZIONI LISP CHIAMABILI DALLA PAGINA (whitelist):");
            foreach (string f in Whitelist)
                ed.WriteMessage("\n  " + f);

            ed.WriteMessage("\n\nFORMATO DEL FILE " + Path.Combine(Folder, CmdFile) + ":");
            ed.WriteMessage("\n  funzione|argomento");
            ed.WriteMessage("\n  Esempio: myfunc|ciao");
            ed.WriteMessage("\n  Argomento: lettere, numeri, spazi, punto, trattino, underscore (max 200)");
            ed.WriteMessage("\n");
        }

        [CommandMethod("BRIDGESTATO")]
        public void BridgeStato()
        {
            Document doc = AcApp.DocumentManager.MdiActiveDocument;
            if (doc == null) return;

            bool attivo = _timer != null && _timer.Enabled;
            doc.Editor.WriteMessage("\n--- AcadBridge ---");
            doc.Editor.WriteMessage("\nStato:        " + (attivo ? "ATTIVO" : "FERMO"));
            doc.Editor.WriteMessage("\nCartella:     " + Folder);
            doc.Editor.WriteMessage("\nFile atteso:  " + CmdFile);
            doc.Editor.WriteMessage("\nIntervallo:   " + (_timer != null ? _timer.Interval : 0) + " ms");
            doc.Editor.WriteMessage("\nFunzioni:     " + string.Join(", ", Whitelist));
            doc.Editor.WriteMessage("\nRicevuti:     " + _ricevuti);
            doc.Editor.WriteMessage("\nUltimo:       " + _ultimo);
            doc.Editor.WriteMessage("\nDLL:          " + typeof(Plugin).Assembly.Location);
            doc.Editor.WriteMessage("\n");
        }

        static void OnTick(object sender, EventArgs e)
        {
            try
            {
                string path = Path.Combine(Folder, CmdFile);
                if (!File.Exists(path)) return;

                Document doc = AcApp.DocumentManager.MdiActiveDocument;
                if (doc == null || !doc.Editor.IsQuiescent) return; // AutoCAD occupato: riprova al prossimo tick

                string line;
                try
                {
                    line = File.ReadAllText(path).Trim();
                    File.Delete(path);
                }
                catch (IOException)
                {
                    return; // file ancora in scrittura: riprova
                }

                int p = line.IndexOf('|');
                if (p <= 0)
                {
                    doc.Editor.WriteMessage("\n[Bridge] Formato non valido.");
                    return;
                }

                string fn = line.Substring(0, p).Trim();
                string arg = line.Substring(p + 1).Trim();

                if (!Whitelist.Contains(fn))
                {
                    doc.Editor.WriteMessage($"\n[Bridge] Funzione non consentita: {fn}");
                    return;
                }
                if (!ArgOk.IsMatch(arg))
                {
                    doc.Editor.WriteMessage("\n[Bridge] Argomento non valido.");
                    return;
                }

                // Chiama la funzione AutoLISP (deve essere già caricata)
                doc.SendStringToExecute($"({fn} \"{arg}\") ", true, false, false);
                _ricevuti++;
                _ultimo = $"{DateTime.Now:HH:mm:ss}  {fn}|{arg}";
            }
            catch (System.Exception ex)
            {
                // Non lasciare mai uscire eccezioni dal timer
                try { AcApp.DocumentManager.MdiActiveDocument?.Editor.WriteMessage("\n[Bridge] Errore: " + ex.Message); }
                catch { }
            }
        }
    }
}
