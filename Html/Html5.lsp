			(setq LstCheck (GetLstIdAndEnameShape))
			(setq TotQta 0)
			(setq TotWgt 0.0)
			(setq Num 0)
			(StartProgressBar "Report" (length LstFoundSearch))
			
			(foreach Mark LstFoundSearch
				(UpDateProgressBar)
				
				(foreach EnameBlock (cdr Mark)

					(setq EnameShape (cadr (assoc (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "IDSHAPE") LstCheck)))

					(setq &ShapeOrder (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "ORDERSHAPE")) 		; nome commessa
					(setq &ShapePhase (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "PHASESHAPE"))		; nome fase
					(setq &ShapeName  (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "MKSHAPE"))			; nome pezzo
					(setq &ShapeQta   (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "QTASHAPE"))			; quantità
					(setq &ShapeTk    (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "TKSHAPE"))			; spessore
					(setq &ShapeMat   (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "MATSHAPE"))			; materiale

					(setq WeightShape (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "WEIGTHSHAPE"))		; peso
					(setq LengthShape (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "LENGTHSHAPE"))		; lunghezza
					(setq WidthShape  (LM:vl-getattributevalue (vlax-ename->vla-object EnameBlock) "HEIGHTSHAPE"))		; larghezza

					(setq &ShapeDim    		(strcat (rtos (atof LengthShape) 2 1) "x" (rtos (atof WidthShape) 2 1)))
					(setq &ShapeTotWeight  	(rtos (* (atof WeightShape) (atoi &ShapeQta)) 2 1))
					(setq &ShapeBarCode 	(GetBarCode EnameShape))
					;
					; Cut List +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
					;
					(princ (strcat "				<tr height=\"30px\" align=\"center\" bgcolor= \"" (Swap Color1 Color2 Num) "\">\n")	Stream)
