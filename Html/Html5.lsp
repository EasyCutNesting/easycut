			(princ (strcat "				<tr height=\"30px\" align=\"center\" bgcolor= \"" (Swap Color1 Color2 1) "\">\n")		Stream)
			(princ "					<td><b>Itm</b></td>\n"																		Stream)
			(princ "					<td><b>Order</b></td>\n"																	Stream)
			(princ "					<td><b>Phase</b></td>\n"																	Stream)
			(princ "					<td><b>Mark</b></td>\n"																		Stream)
