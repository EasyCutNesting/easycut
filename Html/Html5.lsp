										  &ShapeOrder &ShapePhase &ShapeName &ShapeQta &ShapeTk &ShapeMat WeightShape LengthShape WidthShape &ShapeDim &ShapeTotWeight &ShapeBarCode IdRnd) 

										  
										  
	;( ("Com|Phase|Name" EnameShape EnameShape) 
	;  ("Com|Phase|Name" EnameShape EnameShape) 
	;  ("Com|Phase|Name" EnameShape EnameShape))
	;)
	;
